{
  "name": "sena",
  "version": "1.0.0",
  "private": true,
  "description": "A safety-first autonomous Minecraft agent controlled through Discord.",
  "type": "module",
  "engines": {
    "node": ">=24.17.0"
  },
  "scripts": {
    "dev": "tsx src/main.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "lint": "eslint .",
    "format:check": "prettier --check \"src/**/*.ts\" \"tests/**/*.ts\" \"*.json\" \"*.js\" \"*.ts\" \"docs/**/*.md\" README.md",
    "check": "npm run format:check && npm run typecheck && npm run lint && npm test && npm run build"
  },
  "dependencies": {
    "discord.js": "^14.27.0",
    "dotenv": "^16.4.7",
    "mineflayer": "^4.33.0",
    "mineflayer-pathfinder": "^2.4.5",
    "pino": "^9.6.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "eslint": "^9.20.0",
    "prettier": "^3.5.0",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.24.0",
    "vitest": "^5.0.5"
  },
  "overrides": {
    "uuid": "^11.1.1"
  }
}
